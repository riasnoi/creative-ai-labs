# 1 октября 2026 года. Командная строка Engee.
# После «Очистить все переменные» → «Да»:
engee> isdefined(Main, :seed)
true

engee> seed
EngeeNothing()

# После «Перезапуск ядра» → «Перезапустить»:
engee> isdefined(Main, :seed)
false

# В ячейке редактора после перезапуска:
seed = 101
# Вывод ячейки:
101
# Таблица «Переменные»: seed | 101 | Int64 | ()
